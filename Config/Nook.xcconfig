// İmza ayarları. Varsayılan olarak yerel imza ("Sign to Run Locally") kullanılır: geliştirici hesabı olmadan
// derlenir ve çalışır. Ekip kimliği verilirse Config/Signing.xcconfig ondan önce gelir.
// Signing defaults to "Sign to Run Locally" so the project builds without a developer account.
// Create Config/Signing.xcconfig (see Signing.xcconfig.example) to sign with your own team.

DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -

#include? "Signing.xcconfig"
